#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
/ {
    behaviors {
        #include "macros.dtsi"
        #include "behaviors.keymap"
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };
    };

    combos {
        compatible = "zmk,combos";
        #include "combos.keymap"

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp Q   &kp W   &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I   &kp O   &kp P   &kp BSPC
&kp LCTRL  &kp A   &kp S   &kp D   &kp F   &kp G   &kp H   &kp J   &kp K   &kp L   &kp SEMI &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B   &kp N   &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
            &kp LGUI  &kp SPACE  &lt 2 SPACE  &lt 3 ENTER  &kp SPACE  &kp RALT
            >;
        };

        layer_nicola {
            bindings = <
 &macro_ESC  &mm_JPPERIOD    &mm_KA    &mm_TA    &mm_KO    &mm_SA            &mm_RA    &mm_TI    &mm_KU    &mm_TU   &macro_JPCOMMA2     &kp BSPC
 &trans         &mm_U    &mm_SI    &mm_TE    &mm_KE    &mm_SE            &mm_HA    &mm_TO    &mm_KI    &mm_I    &macro_NN  &macro_JPBACKSPACE
 &kp RSHFT  &mm_JPTEN    &mm_HI    &mm_SU    &mm_HU    &mm_HE            &mm_ME    &mm_SO    &macro_NE  &macro_HO  &macro_JPNAKATEN         &kp LSHFT
             &kp LGUI  &kp SPACE  &lt 2 SPACE  &lt 3 ENTER  &kp SPACE  &kp RALT
           >;
        };


        layer_number {
            bindings = <
&kp TAB   &kp N1            &kp N2    &kp N3     &kp N4    &kp N5   &kp N6     &kp N7    &kp N8     &kp N9     &kp N0   &kp DEL
&kp LCTL  &none             &kp HOME  &kp PG_DN  &kp PG_UP &kp END  &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &none    &none
&kp LSHFT &kp LC(LA(DEL))   &kp LGUI  &kp LALT   &none     &mo 4    &none      &none     &none      &kp RGUI   &none    &none
                                 &trans  &trans  &trans                &macro_IMEOFF &macro_IMEON  &mo 4
            >;
        };

        layer_mark {
            bindings = <
&kp TAB   &kp EXCL        &kp AT    &kp HASH  &kp DLLR &kp PRCNT /**/   &kp CARET  &kp AMPS  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp LS(INT3)     &kp INT3
&kp LCTRL &kp LALT        &kp DEL   &none     &none     &none    /**/   &kp MINUS  &kp EQUAL &kp LBKT      &kp RBKT              &kp NUHS     &kp SQT
&kp LSHFT &kp LC(LA(DEL)) &kp LGUI  &kp LALT  &none     &mo 4    /**/   &kp UNDER  &kp PLUS  &kp LBRC      &kp RBRC              &kp LS(NUHS) &kp LS(INT1)
                                     &trans   &macro_IMEOFF  &macro_IMEON           &trans    &trans    &mo 4
            >;
        };

        layer_func {
            bindings = <
&bootloader  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR /**/ &trans  &trans  &trans  &trans  &trans  &bootloader
&trans       &trans          &trans          &trans        &trans        &trans     /**/ &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6
&trans       &rgb_ug RGB_TOG &rgb_ug RGB_EFR &trans        &trans        &trans     /**/ &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
                                    &trans        &trans        &trans  &trans     &trans  &trans
            >;
        };

        extra1 {
            status = "reserved";
        };
        extra2 {
            status = "reserved";
        };
        extra3 {
            status = "reserved";
        };
        extra4 {
            status = "reserved";
        };

    };
};
